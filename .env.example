# ── apps/api ─────────────────────────────────────────────
# Puerto HTTP de la API (Hono sobre Node)
PORT=3001
# Postgres (docker compose up db)
DATABASE_URL=postgresql://watchlog:watchlog@localhost:5432/watchlog
# Secreto de Better Auth (mín. 32 caracteres): openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
# URL pública desde la que el navegador usa la app (web reenvía /api/* a la API)
BETTER_AUTH_URL=http://localhost:3000

# OAuth (opcional: cada proveedor se activa solo si están sus dos variables)
# Callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB: "API Read Access Token" (themoviedb.org → Ajustes → API). Sin él, la búsqueda solo usa AniList.
TMDB_READ_TOKEN=
# Idioma de títulos y sinopsis de TMDB
TMDB_LANGUAGE=es-ES

# Se añadirán en fases posteriores:
# CRON_SECRET=                                                            # Fase 7

# ── packages/db (seed) ───────────────────────────────────
# Código de la invitación de arranque; si se omite se genera uno aleatorio
SEED_INVITE_CODE=bienvenida

# ── apps/web ─────────────────────────────────────────────
# URL interna de la API; web reenvía /api/* aquí
API_URL=http://localhost:3001

# ── docker compose (db) ──────────────────────────────────
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=watchlog
POSTGRES_DB=watchlog
