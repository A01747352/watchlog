# ── apps/api ─────────────────────────────────────────────
# Puerto HTTP de la API (Hono sobre Node)
PORT=3001

# Se añadirán en fases posteriores:
# DATABASE_URL=postgresql://watchlog:watchlog@localhost:5432/watchlog   # Fase 2
# BETTER_AUTH_SECRET=                                                     # Fase 2
# TMDB_READ_TOKEN=                                                        # Fase 3
# CRON_SECRET=                                                            # Fase 7

# ── apps/web ─────────────────────────────────────────────
# URL interna de la API; web reenviará /api/* aquí (rewrite en Fase 2)
API_URL=http://localhost:3001

# ── docker compose (db) ──────────────────────────────────
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=watchlog
POSTGRES_DB=watchlog
